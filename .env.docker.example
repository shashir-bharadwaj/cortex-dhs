# Optional overrides for docker-compose.prod.yml.
# Copy to `.env` (repo root) and edit. Every value has a working default.

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cortex_icu

# if-empty (seed on first run only) | always (reseed + wipe on every start) | never
SEED_MODE=if-empty

FRONTEND_PORT=8080
BACKEND_PORT=8000
# 127.0.0.1 = API/Swagger reachable only from this machine; 0.0.0.0 = from the network
BACKEND_BIND=127.0.0.1
